# ============================================================
# Master API 配置模板
# 复制此文件为 .env：
#   Windows: copy .env.example .env
#   Linux/macOS: cp .env.example .env
# ============================================================

# 数据库后端：sqlite（本地单机模式推荐）或 postgres
DATABASE_BACKEND=sqlite

# SQLite 数据库文件路径（相对路径或绝对路径）
MASTER_API_SQLITE_PATH=master.db

# 管理员密码的 bcrypt 哈希（必填）
# 默认哈希对应的初始密码是：admin12345
# 如需更换密码，可运行命令生成新哈希：
# python -c "import bcrypt; print(bcrypt.hashpw(b'新密码', bcrypt.gensalt(12)).decode())"
MASTER_ADMIN_PASSWORD_HASH=$2b$12$G2mPJpGG75Fu3c1kwUj6T.SgBJHQ1TaqLfD5Ni40u6Olm6WiCxH52

# 本地调试默认客户端 Key（用于本地测试页快捷自测，格式：sk-xxxxxxxx）
MASTER_API_LOCAL_DEMO_KEY=sk-local-demo-key-change-in-production

# CORS 跨域白名单（多个域名用半角逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:8001,http://127.0.0.1:8001

# 控制台 Session 密钥（建议改为至少 32 位的随机字符串）
ADMIN_SESSION_SECRET=change-me-to-a-secure-random-string-at-least-32-chars

# 网关自身基础 URL
GW_BASE_URL=http://127.0.0.1:8000

# ---- 聚合模型 Failover 链调优（可选，以下为默认值）----
# 非末位候选的单次尝试预算（秒）：超过即切换下一个候选
MASTER_API_CHAIN_CANDIDATE_TIMEOUT=60
# 流式候选"提交前探测"窗口（秒）：200 之后先缓冲流的前几个事件，必须等到
# 真实内容块（文本/推理/工具调用）才提交给客户端；发现 error/空流/只有角色块
# 后挂起即静默关闭并切换候选（防聚合上游"先回200再在SSE里报错"）
MASTER_API_CHAIN_STREAM_PROBE=30
# 整链尝试预算（秒）：链开始后超过该时长，跳过剩余"还有备选"的候选；
# 末位兜底候选的等待也被压到剩余预算内。默认 90s——保证网关在客户端/
# 中间代理超时（通常 60~120s）之前给出确定结果，而不是让客户端收到 504/524
MASTER_API_CHAIN_TOTAL_BUDGET=90
# 末位兜底候选的最短等待预算（秒）：整链预算耗尽时兜底模型至少还有一次像样的尝试
MASTER_API_CHAIN_FINAL_MIN=30
# 软熔断冷却：首次触发基准秒数 / 封顶秒数（连续触发按 2 倍升级：30→60→120→240→300）
# 偶发失败（60s 窗口内 <3 次）不会触发熔断；熔断到期后进入试探期，成功即恢复、失败立即再熔断
MASTER_API_CHAIN_COOLDOWN_BASE=30
MASTER_API_CHAIN_COOLDOWN_MAX=300
